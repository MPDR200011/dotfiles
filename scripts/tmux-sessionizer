#!/usr/bin/env python3

import os
import subprocess
import sys
from pathlib import Path

SEARCH_ROOTS = [Path.home() / "crusoe", Path.home() / "personal", Path.home()]


def tmux(*args, **kwargs):
    return subprocess.run(["tmux", *args], **kwargs)


def has_session(name):
    return tmux("has-session", f"-t={name}", stderr=subprocess.DEVNULL).returncode == 0


def candidates():
    for root in SEARCH_ROOTS:
        try:
            entries = sorted(root.iterdir())
        except OSError:
            continue
        for entry in entries:
            if entry.is_dir() and not entry.is_symlink():
                yield str(entry)


def pick():
    result = subprocess.run(
        ["fzf"],
        input="\n".join(candidates()),
        stdout=subprocess.PIPE,
        text=True,
    )
    return result.stdout.strip()


def main():
    selected = sys.argv[1] if len(sys.argv) > 1 else pick()
    if not selected:
        return 0

    name = Path(selected).name.replace(".", "_")

    if not has_session(name):
        tmux("new-session", "-d", "-s", name, "-c", selected, check=True)

    if os.environ.get("TMUX"):
        tmux("switch-client", "-t", name, check=True)
    else:
        os.execvp("tmux", ["tmux", "attach", "-t", name])
    return 0


if __name__ == "__main__":
    sys.exit(main())
